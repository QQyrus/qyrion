# Copy outside the repository/plugin cache and chmod 600 the private copy.
X-API-Key=<your-xapi-key>
# Qyrus tenant URL, not the website under test:
QYRION_APP_URL=https://stg.qyrus.com
# Optional until selection; obtain the exact team UUID through Qyrus MCP:
# qyrus_guide_get, then qyrus_teams_get_by_api_key (not the organization ID).
QYRION_TEAM_ID=
# configure adds QYRUS_MCP_URL derived from QYRION_APP_URL automatically.
