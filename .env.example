# Copy outside the repository/plugin cache and chmod 600 the private copy.
X-API-Key=<your-xapi-key>
# Qyrus tenant URL, not the website under test:
QYRION_APP_URL=https://stg.qyrus.com
# Optional until selection; obtain the exact team UUID through Qyrus MCP:
# qyrus_guide_get, then qyrus_teams_get_by_api_key (not the organization ID).
QYRION_TEAM_ID=
# configure adds QYRUS_MCP_URL derived from QYRION_APP_URL automatically.
# Qyrus tools the MCP bridge lists: progressive (default, 6 tools) or all (every tool).
# QYRUS_MCP_TOOLS=progressive
# Tools to list directly in progressive mode (comma list of tool names):
# QYRUS_MCP_PINNED_TOOLS=qyrus_web_projects_list
# Developers running testhub and runbridge on this computer (no other host is accepted):
# QYRION_TESTHUB_URL=http://127.0.0.1:8081
# QYRION_RUNBRIDGE_URL=http://127.0.0.1:8082
